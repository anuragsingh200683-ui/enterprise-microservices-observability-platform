pipeline {
    agent any

    tools {
        maven 'Maven_3'
        jdk 'JDK21'
        dockerTool 'Docker'
    }

    environment {
        REGISTRY_URL = "localhost:5000"
        DOCKER_HOME  = tool 'Docker'
        PATH         = "${DOCKER_HOME}/bin:${env.PATH}"
        IMAGE_NAME   = "api-gateway"
        IMAGE_TAG    = "latest"
        NAMESPACE    = "microservices"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/anuragsingh200683-ui/enterprise-microservices-observability-platform.git'
            }
        }

        stage('Build JAR') {
            steps {
                dir('api-gateway') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('api-gateway') {
                    sh """
                        docker build -t ${REGISTRY_URL}/${IMAGE_NAME}:${IMAGE_TAG} .
                        docker push ${REGISTRY_URL}/${IMAGE_NAME}:${IMAGE_TAG}
                    """
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh """
                    kubectl apply -f platform/namespace.yaml
                    kubectl apply -f platform/microservices-configmap.yaml
                    kubectl apply -f api-gateway/k8deployment/deployment.yaml
                    kubectl rollout restart deployment/${IMAGE_NAME} -n ${NAMESPACE}
                """
            }
        }

        stage('Verify Deployment') {
            steps {
                sh """
                    kubectl rollout status deployment/${IMAGE_NAME} -n ${NAMESPACE} --timeout=180s
                    kubectl get pods -n ${NAMESPACE} -o wide
                    kubectl get svc -n ${NAMESPACE}
                    kubectl exec -n ${NAMESPACE} deploy/${IMAGE_NAME} -- wget -qO- http://localhost:8080/actuator/health/readiness
                    curl -sf http://host.docker.internal:30080/actuator/health > /dev/null

                    # A Gateway change can break routing to either downstream service even
                    # if the Gateway pod itself is healthy - prove both routes actually work,
                    # retrying since a fresh Gateway pod's own Eureka cache takes a moment to
                    # populate after rollout.
                    for path in /api/employees /api/projects; do
                      ok=false
                      for attempt in \$(seq 1 12); do
                        if curl -sf "http://host.docker.internal:30080\${path}" > /dev/null; then
                          echo "\${path} routing OK (attempt \$attempt)"
                          ok=true
                          break
                        fi
                        sleep 5
                      done
                      if [ "\$ok" != "true" ]; then
                        echo "\${path} routing failed after retries"
                        exit 1
                      fi
                    done
                """
            }
        }
    }

    post {
        success {
            echo "api-gateway build #${env.BUILD_NUMBER} deployed successfully."
        }
        failure {
            echo "api-gateway build #${env.BUILD_NUMBER} failed - check stage logs above."
        }
    }
}
